<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.42.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Main" name="Order Processing" processRef="Process_Main" />
    <bpmn:participant id="Participant_External" name="External System" processRef="Process_External" />
    <bpmn:participant id="Participant_11ygg33" name="very verry long text very big text" processRef="Process_0nimbcq" />
    <bpmn:participant id="Participant_0hzlcb8" name="Empty pool" />
    <bpmn:messageFlow id="MsgFlow_1" sourceRef="Task_Send" targetRef="Event_ExtMsgStart" />
    <bpmn:messageFlow id="MsgFlow_2" sourceRef="Task_ExtReply" targetRef="Event_MsgIntermediate" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Main" name="Order Processing" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Order Received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="Event_TimerStart" name="Daily Batch">
      <bpmn:outgoing>Flow_TimerStart</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Start">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="Event_SignalStart" name="Priority Signal">
      <bpmn:outgoing>Flow_SignalStart</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalDef_Start" signalRef="Signal_Priority" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Event_ConditionalStart" name="Stock Low">
      <bpmn:outgoing>Flow_CondStart</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CondDef_Start">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">#{stock &lt; 10}</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_User" name="Review Order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Service" name="Validate Payment">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Task_Script" name="Calculate Tax">
      <bpmn:incoming>Flow_ParJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInclusive</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="Task_BusinessRule" name="Apply Discount Rules">
      <bpmn:incoming>Flow_Incl1</bpmn:incoming>
      <bpmn:outgoing>Flow_InclJoin1</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:manualTask id="Task_Manual" name="Pack Items">
      <bpmn:incoming>Flow_Incl2</bpmn:incoming>
      <bpmn:outgoing>Flow_InclJoin2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="Task_Send" name="Send Confirmation">
      <bpmn:incoming>Flow_InclJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMsgCatch</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_Receive" name="Await Delivery Confirmation">
      <bpmn:incoming>Flow_FromEventGw2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_Exclusive" name="Payment Valid?" default="Flow_ExDefault">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_ExYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ExDefault</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Parallel_Split" name="Parallel Split">
      <bpmn:incoming>Flow_ExYes</bpmn:incoming>
      <bpmn:outgoing>Flow_Par1</bpmn:outgoing>
      <bpmn:outgoing>Flow_Par2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_Parallel_Join" name="Parallel Join">
      <bpmn:incoming>Flow_Par1Done</bpmn:incoming>
      <bpmn:incoming>Flow_Par2Done</bpmn:incoming>
      <bpmn:outgoing>Flow_ParJoin</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:inclusiveGateway id="Gateway_Inclusive_Split" name="Fulfillment Options">
      <bpmn:incoming>Flow_ToInclusive</bpmn:incoming>
      <bpmn:outgoing>Flow_Incl1</bpmn:outgoing>
      <bpmn:outgoing>Flow_Incl2</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:inclusiveGateway id="Gateway_Inclusive_Join">
      <bpmn:incoming>Flow_InclJoin1</bpmn:incoming>
      <bpmn:incoming>Flow_InclJoin2</bpmn:incoming>
      <bpmn:outgoing>Flow_InclJoin</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:eventBasedGateway id="Gateway_EventBased" name="Wait For Response">
      <bpmn:incoming>Flow_ToEventGw</bpmn:incoming>
      <bpmn:outgoing>Flow_FromEventGw1</bpmn:outgoing>
      <bpmn:outgoing>Flow_FromEventGw2</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:complexGateway id="Gateway_Complex" name="Complex Routing">
      <bpmn:incoming>Flow_TimerStart</bpmn:incoming>
      <bpmn:incoming>Flow_SignalStart</bpmn:incoming>
      <bpmn:incoming>Flow_CondStart</bpmn:incoming>
      <bpmn:outgoing>Flow_ComplexOut</bpmn:outgoing>
    </bpmn:complexGateway>
    <bpmn:serviceTask id="Task_CheckInventory" name="Check Inventory">
      <bpmn:incoming>Flow_Par1</bpmn:incoming>
      <bpmn:outgoing>Flow_Par1Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckFraud" name="Fraud Detection">
      <bpmn:incoming>Flow_Par2</bpmn:incoming>
      <bpmn:outgoing>Flow_Par2Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_MsgIntermediate" name="Response Received">
      <bpmn:incoming>Flow_ToMsgCatch</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEventGw</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Catch" messageRef="Message_Response" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_TimerIntermediate" name="Wait 24h">
      <bpmn:incoming>Flow_FromEventGw1</bpmn:incoming>
      <bpmn:outgoing>Flow_TimerToEscalation</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Intermediate">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Event_SignalThrow" name="Notify Warehouse">
      <bpmn:incoming>Flow_ComplexOut</bpmn:incoming>
      <bpmn:outgoing>Flow_SignalToLink</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalDef_Throw" signalRef="Signal_Warehouse" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_LinkThrow" name="Go To Shipping">
      <bpmn:incoming>Flow_SignalToLink</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkDef_Throw" name="ShippingLink" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Event_LinkCatch" name="From Shipping Link">
      <bpmn:outgoing>Flow_LinkToCompensate</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LinkDef_Catch" name="ShippingLink" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Event_CompensateThrow" name="Trigger Compensation">
      <bpmn:incoming>Flow_LinkToCompensate</bpmn:incoming>
      <bpmn:outgoing>Flow_CompToEnd2</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompDef_Throw" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_EscalationThrow" name="Escalate to Manager">
      <bpmn:incoming>Flow_TimerToEscalation</bpmn:incoming>
      <bpmn:outgoing>Flow_EscToEnd3</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="EscDef_Throw" escalationRef="Escalation_Timeout" />
    </bpmn:intermediateThrowEvent>
    <bpmn:subProcess id="SubProcess_1" name="Handle Returns">
      <bpmn:incoming>Flow_ExDefault</bpmn:incoming>
      <bpmn:outgoing>Flow_SubToCancel</bpmn:outgoing>
      <bpmn:startEvent id="Event_SubStart">
        <bpmn:outgoing>Flow_Sub1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Task_SubUser" name="Process Refund">
        <bpmn:incoming>Flow_Sub1</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="Event_SubEnd">
        <bpmn:incoming>Flow_Sub2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Sub1" sourceRef="Event_SubStart" targetRef="Task_SubUser" />
      <bpmn:sequenceFlow id="Flow_Sub2" sourceRef="Task_SubUser" targetRef="Event_SubEnd" />
    </bpmn:subProcess>
    <bpmn:callActivity id="CallActivity_1" name="Invoke Shipping Process">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
      <bpmn:outgoing>Flow_CallToEnd</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="Event_BoundaryTimer" cancelActivity="false" attachedToRef="Task_User">
      <bpmn:outgoing>Flow_BoundaryTimer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Boundary">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_BoundaryError" attachedToRef="Task_Service">
      <bpmn:outgoing>Flow_BoundaryError</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Boundary" errorRef="Error_Payment" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_BoundaryMsg" attachedToRef="Task_CheckInventory">
      <bpmn:outgoing>Flow_BoundaryMsg</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Boundary" messageRef="Message_Cancel" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_BoundarySignal" cancelActivity="false" attachedToRef="SubProcess_1">
      <bpmn:outgoing>Flow_BoundarySignal</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalDef_Boundary" signalRef="Signal_Priority" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_End" name="Order Complete">
      <bpmn:incoming>Flow_CallToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_EndError" name="Payment Failed">
      <bpmn:incoming>Flow_BoundaryError</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorDef_End" errorRef="Error_Payment" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_EndSignal" name="Signal Sent">
      <bpmn:incoming>Flow_BoundarySignal</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalDef_End" signalRef="Signal_Warehouse" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_EndTerminate" name="Abort Process">
      <bpmn:incoming>Flow_BoundaryMsg</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TermDef_End" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_EndCancel" name="Order Cancelled">
      <bpmn:incoming>Flow_SubToCancel</bpmn:incoming>
      <bpmn:cancelEventDefinition id="CancelDef_End" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_EndEscalation" name="Escalated">
      <bpmn:incoming>Flow_EscToEnd3</bpmn:incoming>
      <bpmn:escalationEventDefinition id="EscDef_End" escalationRef="Escalation_Timeout" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_EndCompensate" name="Compensated">
      <bpmn:incoming>Flow_CompToEnd2</bpmn:incoming>
      <bpmn:compensateEventDefinition id="CompDef_End" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_EndMessage" name="Notification Sent">
      <bpmn:incoming>Flow_BoundaryTimer</bpmn:incoming>
      <bpmn:messageEventDefinition id="MsgDef_End" messageRef="Message_Reminder" />
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObject_1" name="Order Data" dataObjectRef="DataObj_1" />
    <bpmn:dataObject id="DataObj_1" />
    <bpmn:dataStoreReference id="DataStore_1" name="Order Database" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Task_User" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_User" targetRef="Task_Service" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Service" targetRef="Gateway_Exclusive" />
    <bpmn:sequenceFlow id="Flow_ExYes" name="Yes" sourceRef="Gateway_Exclusive" targetRef="Gateway_Parallel_Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">#{paymentValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ExDefault" name="No" sourceRef="Gateway_Exclusive" targetRef="SubProcess_1" />
    <bpmn:sequenceFlow id="Flow_Par1" sourceRef="Gateway_Parallel_Split" targetRef="Task_CheckInventory" />
    <bpmn:sequenceFlow id="Flow_Par2" sourceRef="Gateway_Parallel_Split" targetRef="Task_CheckFraud" />
    <bpmn:sequenceFlow id="Flow_Par1Done" sourceRef="Task_CheckInventory" targetRef="Gateway_Parallel_Join" />
    <bpmn:sequenceFlow id="Flow_Par2Done" sourceRef="Task_CheckFraud" targetRef="Gateway_Parallel_Join" />
    <bpmn:sequenceFlow id="Flow_ParJoin" sourceRef="Gateway_Parallel_Join" targetRef="Task_Script" />
    <bpmn:sequenceFlow id="Flow_ToInclusive" sourceRef="Task_Script" targetRef="Gateway_Inclusive_Split" />
    <bpmn:sequenceFlow id="Flow_Incl1" sourceRef="Gateway_Inclusive_Split" targetRef="Task_BusinessRule" />
    <bpmn:sequenceFlow id="Flow_Incl2" sourceRef="Gateway_Inclusive_Split" targetRef="Task_Manual" />
    <bpmn:sequenceFlow id="Flow_InclJoin1" sourceRef="Task_BusinessRule" targetRef="Gateway_Inclusive_Join" />
    <bpmn:sequenceFlow id="Flow_InclJoin2" sourceRef="Task_Manual" targetRef="Gateway_Inclusive_Join" />
    <bpmn:sequenceFlow id="Flow_InclJoin" sourceRef="Gateway_Inclusive_Join" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="Flow_ToMsgCatch" sourceRef="Task_Send" targetRef="Event_MsgIntermediate" />
    <bpmn:sequenceFlow id="Flow_ToEventGw" sourceRef="Event_MsgIntermediate" targetRef="Gateway_EventBased" />
    <bpmn:sequenceFlow id="Flow_FromEventGw1" sourceRef="Gateway_EventBased" targetRef="Event_TimerIntermediate" />
    <bpmn:sequenceFlow id="Flow_FromEventGw2" sourceRef="Gateway_EventBased" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_Receive" targetRef="CallActivity_1" />
    <bpmn:sequenceFlow id="Flow_CallToEnd" sourceRef="CallActivity_1" targetRef="Event_End" />
    <bpmn:sequenceFlow id="Flow_TimerStart" sourceRef="Event_TimerStart" targetRef="Gateway_Complex" />
    <bpmn:sequenceFlow id="Flow_SignalStart" sourceRef="Event_SignalStart" targetRef="Gateway_Complex" />
    <bpmn:sequenceFlow id="Flow_CondStart" sourceRef="Event_ConditionalStart" targetRef="Gateway_Complex" />
    <bpmn:sequenceFlow id="Flow_ComplexOut" sourceRef="Gateway_Complex" targetRef="Event_SignalThrow" />
    <bpmn:sequenceFlow id="Flow_SignalToLink" sourceRef="Event_SignalThrow" targetRef="Event_LinkThrow" />
    <bpmn:sequenceFlow id="Flow_LinkToCompensate" sourceRef="Event_LinkCatch" targetRef="Event_CompensateThrow" />
    <bpmn:sequenceFlow id="Flow_CompToEnd2" sourceRef="Event_CompensateThrow" targetRef="Event_EndCompensate" />
    <bpmn:sequenceFlow id="Flow_TimerToEscalation" sourceRef="Event_TimerIntermediate" targetRef="Event_EscalationThrow" />
    <bpmn:sequenceFlow id="Flow_EscToEnd3" sourceRef="Event_EscalationThrow" targetRef="Event_EndEscalation" />
    <bpmn:sequenceFlow id="Flow_SubToCancel" sourceRef="SubProcess_1" targetRef="Event_EndCancel" />
    <bpmn:sequenceFlow id="Flow_BoundaryTimer" sourceRef="Event_BoundaryTimer" targetRef="Event_EndMessage" />
    <bpmn:sequenceFlow id="Flow_BoundaryError" sourceRef="Event_BoundaryError" targetRef="Event_EndError" />
    <bpmn:sequenceFlow id="Flow_BoundaryMsg" sourceRef="Event_BoundaryMsg" targetRef="Event_EndTerminate" />
    <bpmn:sequenceFlow id="Flow_BoundarySignal" sourceRef="Event_BoundarySignal" targetRef="Event_EndSignal" />
    <bpmn:textAnnotation id="TextAnnotation_1">
      <bpmn:text>All orders must be validated within 24 hours</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="Task_User" targetRef="TextAnnotation_1" />
  </bpmn:process>
  <bpmn:process id="Process_External" name="External System" isExecutable="false">
    <bpmn:startEvent id="Event_ExtMsgStart" name="Request Received">
      <bpmn:outgoing>Flow_Ext1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_ExtStart" messageRef="Message_Request" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ExtProcess" name="Process Request">
      <bpmn:incoming>Flow_Ext1</bpmn:incoming>
      <bpmn:outgoing>Flow_Ext2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_ExtReply" name="Send Response">
      <bpmn:incoming>Flow_Ext2</bpmn:incoming>
      <bpmn:outgoing>Flow_Ext3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_ExtEnd" name="Done">
      <bpmn:incoming>Flow_Ext3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Ext1" sourceRef="Event_ExtMsgStart" targetRef="Task_ExtProcess" />
    <bpmn:sequenceFlow id="Flow_Ext2" sourceRef="Task_ExtProcess" targetRef="Task_ExtReply" />
    <bpmn:sequenceFlow id="Flow_Ext3" sourceRef="Task_ExtReply" targetRef="Event_ExtEnd" />
  </bpmn:process>
  <bpmn:signal id="Signal_Priority" name="PriorityOrder" />
  <bpmn:signal id="Signal_Warehouse" name="WarehouseNotification" />
  <bpmn:message id="Message_Response" name="OrderResponse" />
  <bpmn:message id="Message_Cancel" name="CancelOrder" />
  <bpmn:message id="Message_Request" name="OrderRequest" />
  <bpmn:message id="Message_Reminder" name="ReminderNotification" />
  <bpmn:error id="Error_Payment" name="PaymentError" errorCode="ERR_PAYMENT" />
  <bpmn:escalation id="Escalation_Timeout" name="TimeoutEscalation" escalationCode="ESC_TIMEOUT" />
  <bpmn:process id="Process_0nimbcq" isExecutable="false" />
